#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1
PROG=/root/sa5g_monitor.sh
PIDFILE=/var/run/sa5g_monitor.pid

start_service() {
    logger -t sa5g_monitor_init "Starting SA 5G monitor service."
    procd_open_instance
    procd_set_param command "$PROG"
    procd_set_param pidfile "$PIDFILE"
    procd_set_param respawn 3600 5 5   # restart if dies after 1 hour
    procd_close_instance
}

stop_service() {
    logger -t sa5g_monitor_init "Stopping SA 5G monitor service."
    if [ -f "$PIDFILE" ]; then
        kill $(cat "$PIDFILE") 2>/dev/null
        rm -f "$PIDFILE"
    fi
}

service_triggers() {
    procd_add_reload_trigger "sa5g_monitor"
}




