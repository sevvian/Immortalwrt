#!/bin/sh
MODEM_DEVICE="/dev/ttyUSB2"
POLL_INTERVAL=10
LOGFILE="/var/log/sa5g_monitor.log"
PIDFILE="/var/run/sa5g_monitor.pid"
STATUSFILE="/tmp/sa5g_monitor_status.json"

# ---- Timings & thresholds --------------------------------------------------
BOOT_GRACE=10                    # seconds after (re)start before reacting
CONNECTIVITY_TIMEOUT=30          # seconds with PDP=1 but no IP → trigger recovery
RECONNECT_COOLDOWN=180           # seconds between recovery attempts
MAX_IFDOWN_RETRIES=2             # max Stage‑0 restarts before escalating
PDP_ZERO_DEBOUNCE=2              # consecutive polls of PDP=0 before drop confirmed
MODEM_MISSING_THRESHOLD=6        # 6 * 10s = 60 seconds before router reboot
# ----------------------------------------------------------------------------

log_msg() {
    local now=$(date)
    echo "$now: $1" | tee -a "$LOGFILE"
    logger -t "sa5g_monitor" "$1"
}

write_status() {
    SERVING_CELL_CLEAN=$(echo "$SERVING_CELL_INFO" | tr -d '\r\n' | sed 's/"/\\"/g')
    cat > "$STATUSFILE" << EOF
{
  "registration_state": "${REG_STAT:-}",
  "pdp_state": "${PDP_STATE:-}",
  "scc_count": "${SCC_COUNT:-0}",
  "serving_cell": "${SERVING_CELL_CLEAN:-}",
  "connected_since": "${CONNECTED_SINCE:-}",
  "script_running": "1",
  "drops_total": "${DROP_COUNT:-0}",
  "recovery_attempts": "${RECOVERY_ATTEMPTS:-0}",
  "recovery_success": "${RECOVERY_SUCCESS:-0}",
  "last_downtime": "${LAST_DOWNTIME:-}",
  "last_drop_reason": "${LAST_DROP_REASON:-}"
}
EOF
}

has_ip() {
    ip -4 addr show dev wwan0_1 2>/dev/null | grep -q "inet "
}

modem_ready() {
    sms_tool -d "$MODEM_DEVICE" at "AT+C5GREG?" 2>/dev/null | grep -q "+C5GREG:"
}

qmi_ready() {
    [ -e /dev/cdc-wdm0 ]
}

modem_present() {
    [ -e "$MODEM_DEVICE" ] && [ -e /dev/cdc-wdm0 ]
}

reconnect_interface() {
    log_msg "  -> Stage 0: Restarting wwan99 (notify_proto + ifup)."
    RECOVERY_ATTEMPTS=$((RECOVERY_ATTEMPTS + 1))

    log_msg "     Waiting for modem AT readiness..."
    for i in $(seq 1 30); do
        modem_ready && break
        sleep 3
    done
    log_msg "     Waiting for /dev/cdc-wdm0..."
    for i in $(seq 1 30); do
        qmi_ready && break
        sleep 3
    done

    log_msg "     Notifying netifd that wwan99 is available..."
    ubus call network.interface.wwan99 notify_proto '{"action":5, "available":true}' 2>/dev/null
    sleep 1
    log_msg "     Bringing wwan99 up..."
    ifup wwan99
    sleep 5

    log_msg "     Waiting for IP on wwan0_1..."
    for i in $(seq 1 24); do
        if has_ip; then
            log_msg "     IP acquired."
            break
        fi
        sleep 5
    done

    if ! has_ip; then
        log_msg "     WARNING: No IP after interface restart."
    fi
}

reset_modem_radio() {
    log_msg "  -> Stage 1: Radio reset (AT+CFUN=0/1)."
    RECOVERY_ATTEMPTS=$((RECOVERY_ATTEMPTS + 1))
    sms_tool -d "$MODEM_DEVICE" at "AT+CFUN=0" 2>/dev/null
    sleep 5
    sms_tool -d "$MODEM_DEVICE" at "AT+CFUN=1" 2>/dev/null
    sleep 15
    reconnect_interface
}

reboot_modem() {
    log_msg "  -> Stage 2: Full modem reboot (AT+CFUN=1,1)."
    RECOVERY_ATTEMPTS=$((RECOVERY_ATTEMPTS + 1))
    sms_tool -d "$MODEM_DEVICE" at "AT+CFUN=1,1" 2>/dev/null
    sleep 5
    log_msg "     Modem rebooting. Monitor exiting – procd will restart it."
    exit 0
}

cleanup() {
    log_msg "Monitor stopped."
    echo '{"script_running":"0"}' > "$STATUSFILE"
    rm -f "$PIDFILE"
    exit 0
}
trap cleanup TERM INT

echo $$ > "$PIDFILE"
log_msg "Waiting for 5G SA modem..."
for i in $(seq 1 36); do
    if modem_ready; then
        log_msg "Modem ready."
        break
    fi
    sleep 5
done

if ! modem_ready; then
    log_msg "Modem not responding. Exiting."
    echo '{"script_running":"0"}' > "$STATUSFILE"
    rm -f "$PIDFILE"
    exit 1
fi

# Counters and state
DROP_COUNT=0
RECOVERY_ATTEMPTS=0
RECOVERY_SUCCESS=0
LAST_DROP_TIME=""
LAST_DOWNTIME=""
LAST_DROP_REASON=""
CONNECTED_SINCE=""

HAS_SEEN_ACTIVE_PDP=0
CONSECUTIVE_DROPS=0
LAST_RECONNECT=0
STAGE=0
DROP_ACTIVE=0
PREV_SCC_COUNT=-1
PDP_ZERO_COUNT=0
MONITOR_START=$(date +%s)
NO_IP_TIMER=0
MODEM_MISSING_COUNT=0

log_msg "Monitor started."

while true; do
    # ------------------------------------------------------------------
    # 1. Hotplug flag check – instant reactivation
    # ------------------------------------------------------------------
    if [ -e /tmp/modem_reconnected ] && modem_present; then
        log_msg "Hotplug event detected – immediate recovery."
        rm -f /tmp/modem_reconnected
        MODEM_MISSING_COUNT=0
        DROP_ACTIVE=0
        PDP_ZERO_COUNT=0
        NO_IP_TIMER=0
        reconnect_interface
        sleep $POLL_INTERVAL
        continue
    fi

    # ------------------------------------------------------------------
    # 2. Modem presence watchdog
    # ------------------------------------------------------------------
    if ! modem_present; then
        MODEM_MISSING_COUNT=$((MODEM_MISSING_COUNT + 1))
        log_msg "Modem device(s) missing. Count: $MODEM_MISSING_COUNT/$MODEM_MISSING_THRESHOLD"

        # Inform dashboard
        SERVING_CELL_INFO="MODEM_MISSING"
        REG_STAT=""; PDP_STATE=""; SCC_COUNT="0"
        CONNECTED_SINCE=""
        write_status

        if [ $MODEM_MISSING_COUNT -ge $MODEM_MISSING_THRESHOLD ]; then
            log_msg "Modem missing for too long. Rebooting router (Stage 3)."
            reboot
        fi
        sleep $POLL_INTERVAL
        continue
    else
        MODEM_MISSING_COUNT=0
    fi

    # ------------------------------------------------------------------
    # 3. Normal AT data gathering (modem present)
    # ------------------------------------------------------------------
    C5GREG_OUT=$(sms_tool -d "$MODEM_DEVICE" at "AT+C5GREG?" 2>/dev/null | tr -d '\r')
    REG_STAT=$(echo "$C5GREG_OUT" | grep "+C5GREG:" | awk -F'[, ]' '{print $3}')

    QENG_OUT=$(sms_tool -d "$MODEM_DEVICE" at 'AT+QENG="servingcell"' 2>/dev/null | grep "+QENG:")
    SERVING_CELL_INFO=$(echo "$QENG_OUT" | sed -n 's/^+QENG: //p')

    QCAINFO_OUT=$(sms_tool -d "$MODEM_DEVICE" at "AT+QCAINFO" 2>/dev/null | grep "+QCAINFO:")
    SCC_COUNT=$(echo "$QCAINFO_OUT" | grep -c "SCC")

    CGACT_OUT=$(sms_tool -d "$MODEM_DEVICE" at "AT+CGACT?" 2>/dev/null | tr -d '\r')
    PDP_STATE=$(echo "$CGACT_OUT" | grep "+CGACT:" | grep -o "1,[01]" | awk -F',' '{print $2}')
    [ -z "$PDP_STATE" ] && PDP_STATE=1

    NOW=$(date +%s)

    # Track active PDP
    if [ "$PDP_STATE" = "1" ]; then
        HAS_SEEN_ACTIVE_PDP=1
        if [ -z "$CONNECTED_SINCE" ]; then
            CONNECTED_SINCE=$NOW
        fi
    else
        CONNECTED_SINCE=""
    fi

    # Debounce PDP zero
    if [ "$PDP_STATE" = "0" ]; then
        PDP_ZERO_COUNT=$((PDP_ZERO_COUNT + 1))
    else
        PDP_ZERO_COUNT=0
    fi

    IN_GRACE=0
    [ $((NOW - MONITOR_START)) -lt $BOOT_GRACE ] && IN_GRACE=1

    # ------------------------------------------------------------------
    # 4. Connectivity watchdog (PDP active but no IP)
    # ------------------------------------------------------------------
    if [ "$PDP_STATE" = "1" ] && ! has_ip; then
        if [ "$NO_IP_TIMER" -eq 0 ]; then
            NO_IP_TIMER=$NOW
        elif [ $((NOW - NO_IP_TIMER)) -ge $CONNECTIVITY_TIMEOUT ] && [ "$IN_GRACE" -eq 0 ]; then
            if [ "$DROP_ACTIVE" != "1" ]; then
                DROP_ACTIVE=1
                CONSECUTIVE_DROPS=$((CONSECUTIVE_DROPS + 1))
                DROP_COUNT=$((DROP_COUNT + 1))
                LAST_DROP_TIME=$NOW
                LAST_DROP_REASON="No IP despite active PDP (possible NO_DEVICE)."
                log_msg "DROP #$DROP_COUNT: $LAST_DROP_REASON"
                NO_IP_TIMER=0
            fi
        fi
    else
        NO_IP_TIMER=0
    fi

    # ------------------------------------------------------------------
    # 5. Classic drop detection (sustained PDP loss)
    # ------------------------------------------------------------------
    if [ $PDP_ZERO_COUNT -ge $PDP_ZERO_DEBOUNCE ] && [ $HAS_SEEN_ACTIVE_PDP -eq 1 ] && [ "$IN_GRACE" -eq 0 ]; then
        if [ "$DROP_ACTIVE" != "1" ]; then
            DROP_ACTIVE=1
            CONSECUTIVE_DROPS=$((CONSECUTIVE_DROPS + 1))
            DROP_COUNT=$((DROP_COUNT + 1))
            LAST_DROP_TIME=$NOW
            LAST_DROP_REASON="PDP context lost (sustained)."
            log_msg "DROP #$DROP_COUNT: $LAST_DROP_REASON"
        fi
    fi

    # ------------------------------------------------------------------
    # 6. Recovery success
    # ------------------------------------------------------------------
    if [ "$DROP_ACTIVE" = "1" ] && [ "$PDP_STATE" = "1" ] && has_ip; then
        RECOVERY_SUCCESS=$((RECOVERY_SUCCESS + 1))
        [ -n "$LAST_DROP_TIME" ] && LAST_DOWNTIME=$((NOW - LAST_DROP_TIME))
        DROP_ACTIVE=0; CONSECUTIVE_DROPS=0; STAGE=0; PDP_ZERO_COUNT=0; NO_IP_TIMER=0
        log_msg "Recovery successful. Downtime: ${LAST_DOWNTIME}s"
    fi

    # ------------------------------------------------------------------
    # 7. Staged recovery actions
    # ------------------------------------------------------------------
    if [ "$DROP_ACTIVE" = "1" ] && [ "$IN_GRACE" -eq 0 ]; then
        if [ $((NOW - LAST_RECONNECT)) -lt $RECONNECT_COOLDOWN ]; then
            if [ $CONSECUTIVE_DROPS -gt $MAX_IFDOWN_RETRIES ]; then
                if [ $STAGE -eq 0 ]; then
                    STAGE=1; CONSECUTIVE_DROPS=0
                    reset_modem_radio
                elif [ $STAGE -eq 1 ]; then
                    STAGE=2; CONSECUTIVE_DROPS=0
                    reboot_modem
                else
                    log_msg "Already at Stage 2, waiting."
                    CONSECUTIVE_DROPS=0
                fi
                LAST_RECONNECT=$NOW
            else
                reconnect_interface
                LAST_RECONNECT=$NOW
            fi
        else
            CONSECUTIVE_DROPS=1; STAGE=0
            reconnect_interface
            LAST_RECONNECT=$NOW
        fi
    fi

    write_status
    PREV_SCC_COUNT=$SCC_COUNT
    sleep $POLL_INTERVAL
done




