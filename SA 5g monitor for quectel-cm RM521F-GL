<script type="text/javascript">
    function doAction(cmd) {
        var xhr = new XMLHttpRequest();
        xhr.open("POST", "<%=url('admin/services/sa5g_monitor/action')%>", true);
        xhr.setRequestHeader("Content-Type", "application/x-www-form-urlencoded");
        xhr.onload = function() {
            if (xhr.status == 200) {
                document.getElementById("action_feedback").innerHTML = '<%: Command sent. %>';
            } else {
                document.getElementById("action_feedback").innerHTML = '<%: Error. %>';
            }
            setTimeout(function(){ document.getElementById("action_feedback").innerHTML = ''; }, 3000);
        };
        xhr.send("cmd=" + cmd);
    }

    function updateStatus() {
        var xhr = new XMLHttpRequest();
        xhr.open("GET", "<%=url('admin/services/sa5g_monitor/uci')%>", true);
        xhr.onload = function() {
            if (xhr.status == 200) {
                var data = JSON.parse(xhr.responseText);

                // Check for modem missing state
                if (data.serving_cell === "MODEM_MISSING") {
                    document.getElementById("modem_missing_alert").style.display = "block";
                    document.getElementById("normal_status_table").style.display = "none";
                    document.getElementById("script_running").textContent = (data.script_running == "1") ? '<%: Yes %>' : '<%: No %>';
                    // Recovery stats still show from script (they'll be zeroed)
                } else {
                    document.getElementById("modem_missing_alert").style.display = "none";
                    document.getElementById("normal_status_table").style.display = "";

                    var pdp = data.pdp_state;
                    if (pdp == "1") {
                        document.getElementById("pdp_status").textContent = '<%: Active %>';
                        document.getElementById("pdp_status").style.color = 'green';
                    } else {
                        document.getElementById("pdp_status").textContent = '<%: Inactive %>';
                        document.getElementById("pdp_status").style.color = 'red';
                    }

                    var reg = data.registration_state;
                    if (reg === "1") reg = '<%: Home %>';
                    else if (reg === "5") reg = '<%: Roaming %>';
                    else if (reg === "2") reg = '<%: Searching %>';
                    else reg = reg || '--';
                    document.getElementById("reg_state").textContent = reg;

                    document.getElementById("scc_count").textContent = data.scc_count || '0';
                    document.getElementById("serving_cell").textContent = data.serving_cell || '--';
                    document.getElementById("script_running").textContent = (data.script_running == "1") ? '<%: Yes %>' : '<%: No %>';

                    var since = parseInt(data.connected_since);
                    if (since > 0) {
                        var uptime = Math.floor(Date.now()/1000) - since;
                        var h = Math.floor(uptime/3600);
                        var m = Math.floor((uptime%3600)/60);
                        var s = uptime % 60;
                        document.getElementById("uptime").textContent = h + "h " + m + "m " + s + "s";
                        document.getElementById("uptime").style.color = 'green';
                    } else {
                        document.getElementById("uptime").textContent = '<%: Disconnected %>';
                        document.getElementById("uptime").style.color = 'red';
                    }
                }

                // Common recovery stats
                document.getElementById("drops_total").textContent = data.drops_total || 0;
                document.getElementById("recov_attempts").textContent = data.recovery_attempts || 0;
                document.getElementById("recov_success").textContent = data.recovery_success || 0;
                var rate = 0;
                if (data.recovery_attempts > 0) rate = Math.round(data.recovery_success / data.recovery_attempts * 100);
                document.getElementById("success_rate").textContent = rate + '%';
                document.getElementById("last_downtime").textContent = (data.last_downtime ? data.last_downtime + ' s' : '--');
                document.getElementById("last_reason").textContent = data.last_drop_reason || '--';
            }
        };
        xhr.send();
    }

    function updateLog() {
        var xhr = new XMLHttpRequest();
        xhr.open("GET", "<%=url('admin/services/sa5g_monitor/log')%>", true);
        xhr.onload = function() {
            if (xhr.status == 200) {
                document.getElementById("log_area").textContent = xhr.responseText;
            }
        };
        xhr.send();
    }

    setInterval(updateStatus, 10000);
    updateStatus();
    setInterval(updateLog, 10000);
    updateLog();
</script>
