#!/bin/sh
# When the Quectel modem USB device appears, signal the monitor to check readiness.
# Only trigger for our specific modem (idVendor=2c7c, idProduct=801)
PRODUCT_ID="2c7c/801"   # from your log: idVendor=0x2c7c, idProduct=0x801

case "$ACTION" in
    add)
        # Wait a brief moment for ttyUSB* and cdc-wdm0 to be registered
        sleep 2
        # Touch a flag file – the monitor will react
        touch /tmp/modem_reconnected
        logger -t modem_hotplug "Modem USB device added – signalled monitor."
        ;;
    remove)
        # Modem disappeared – delete flag (monitor will detect missing devices via its own check)
        rm -f /tmp/modem_reconnected
        logger -t modem_hotplug "Modem USB device removed."
        ;;
esac



