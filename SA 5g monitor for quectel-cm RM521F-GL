module("luci.controller.sa5g_monitor", package.seeall)

function index()
    entry({"admin", "services", "sa5g_monitor"}, firstchild(), _("SA 5G Monitor"), 60).dependent = false
    entry({"admin", "services", "sa5g_monitor", "overview"}, template("sa5g_monitor/overview"), _("Overview"), 1).leaf = true
    entry({"admin", "services", "sa5g_monitor", "action"}, call("action_handler")).leaf = true
    entry({"admin", "services", "sa5g_monitor", "uci"}, call("action_uci")).leaf = true
    entry({"admin", "services", "sa5g_monitor", "log"}, call("action_log")).leaf = true
end

function action_handler()
    local cmd = luci.http.formvalue("cmd")

    if cmd == "start" or cmd == "stop" or cmd == "restart" then
        os.execute("/etc/init.d/sa5g_monitor " .. cmd)
        luci.http.prepare_content("application/json")
        luci.http.write_json({ result = "ok" })
        return
    end

    local script = nil

    if cmd == "force_reconnect" then
        script = "( " ..
            "exec >>/var/log/sa5g_force_reboot.log 2>&1; " ..
            "echo \"$(date): Force reconnect started\"; " ..
            "/etc/init.d/sa5g_monitor stop; " ..
            "ifdown wwan99; sleep 5; " ..
            "for i in $(seq 1 20); do sms_tool -d /dev/ttyUSB2 at 'AT+C5GREG?' 2>/dev/null | grep -q '+C5GREG:' && break; sleep 3; done; " ..
            "for i in $(seq 1 20); do [ -e /dev/cdc-wdm0 ] && break; sleep 3; done; " ..
            "ifup wwan99; sleep 15; " ..
            "/etc/init.d/sa5g_monitor start; " ..
            "echo \"$(date): Force reconnect complete\" " ..
        ") &"
    elseif cmd == "force_radio" then
        script = "( " ..
            "exec >>/var/log/sa5g_force_reboot.log 2>&1; " ..
            "echo \"$(date): Force radio reset started\"; " ..
            "/etc/init.d/sa5g_monitor stop; " ..
            "sms_tool -d /dev/ttyUSB2 at 'AT+CFUN=0' 2>/dev/null; sleep 5; " ..
            "sms_tool -d /dev/ttyUSB2 at 'AT+CFUN=1' 2>/dev/null; sleep 15; " ..
            "for i in $(seq 1 20); do sms_tool -d /dev/ttyUSB2 at 'AT+C5GREG?' 2>/dev/null | grep -q '+C5GREG:' && break; sleep 3; done; " ..
            "for i in $(seq 1 20); do [ -e /dev/cdc-wdm0 ] && break; sleep 3; done; " ..
            "ifup wwan99; sleep 15; " ..
            "/etc/init.d/sa5g_monitor start; " ..
            "echo \"$(date): Force radio reset complete\" " ..
        ") &"
    elseif cmd == "force_reboot" then
        script = "( " ..
            "exec >>/var/log/sa5g_force_reboot.log 2>&1; " ..
            "echo \"$(date): Force reboot started\"; " ..
            "/etc/init.d/sa5g_monitor stop; " ..
            "sms_tool -d /dev/ttyUSB2 at 'AT+CFUN=1,1' 2>/dev/null; sleep 5; " ..
            "sleep 40; " ..
            "echo \"$(date): Waiting for modem...\"; " ..
            "for i in $(seq 1 30); do sms_tool -d /dev/ttyUSB2 at 'AT+C5GREG?' 2>/dev/null | grep -q '+C5GREG:' && break; sleep 3; done; " ..
            "for i in $(seq 1 30); do [ -e /dev/cdc-wdm0 ] && break; sleep 3; done; " ..
            "echo \"$(date): Notifying netifd & bringing up wwan99...\"; " ..
            "ubus call network.interface.wwan99 notify_proto '{\"action\":5, \"available\":true}' 2>/dev/null; " ..
            "sleep 1; " ..
            "ifup wwan99; " ..
            "sleep 15; " ..
            "/etc/init.d/sa5g_monitor start; " ..
            "echo \"$(date): Force reboot complete\" " ..
        ") &"
    else
        luci.http.status(400, "Bad Request")
        return
    end

    os.execute(script)
    luci.http.prepare_content("application/json")
    luci.http.write_json({ result = "ok" })
end

function action_uci()
    local file = io.open("/tmp/sa5g_monitor_status.json", "r")
    if not file then
        luci.http.status(500, "No status file")
        luci.http.write('{"error":"no status file"}')
        return
    end
    local content = file:read("*all")
    file:close()
    luci.http.prepare_content("application/json")
    luci.http.write(content)
end

function action_log()
    local file = io.open("/var/log/sa5g_monitor.log", "r")
    local content = ""
    if file then
        local lines = {}
        for line in file:lines() do
            table.insert(lines, line)
            if #lines > 50 then table.remove(lines, 1) end
        end
        file:close()
        content = table.concat(lines, "\n")
    end
    luci.http.prepare_content("text/plain")
    luci.http.write(content)
end


