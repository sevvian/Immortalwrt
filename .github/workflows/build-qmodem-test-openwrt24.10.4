name: Build QModem for OpenWrt 24.10.4

on:
  workflow_dispatch:
  push:
    branches: [ main ]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout QModem Repository
        uses: actions/checkout@v4
        with:
          repository: FUjr/QModem
          path: qmodem-src

      - name: Install Build Dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y build-essential libncurses5-dev libncursesw5-dev \
            zlib1g-dev gawk git gettext libssl-dev xsltproc rsync wget unzip python3

      - name: Download and Setup OpenWrt SDK
        run: |
          SDK_URL="https://downloads.openwrt.org/releases/24.10.4/targets/mvebu/cortexa9/openwrt-sdk-24.10.4-mvebu-cortexa9_gcc-13.3.0_musl.Linux-x86_64.tar.xz"
          wget $SDK_URL
          tar -xJf *.tar.xz
          mv openwrt-sdk-* sdk

      - name: Update and Install Feeds
        working-directory: sdk
        run: |
          ./scripts/feeds update -a
          ./scripts/feeds install -a

      - name: Integrate QModem Drivers & Apps
        run: |
          # Create a custom package directory in the SDK
          mkdir -p sdk/package/qmodem
          # Copy all drivers/apps from the source to the SDK
          cp -r qmodem-src/driver/* sdk/package/qmodem/
          
          # Fix common issues: Ensure every subfolder is treated as a package
          # The SDK needs to know about these new packages
          cd sdk
          ./scripts/feeds update -i
          
      - name: Configure and Build
        working-directory: sdk
        run: |
          # Generate default config for the target
          make defconfig
          
          # Identify all packages copied into the qmodem directory
          # and compile them one by one
          for pkg in $(ls package/qmodem); do
            echo "Building package: $pkg"
            make package/qmodem/$pkg/compile V=s || true
          done

      - name: Collect Artifacts
        run: |
          mkdir -p output
          find sdk/bin/packages/arm_cortex-a9_vfpv3-d16/ -name "*.ipk" -exec cp {} output/ \;
          # Also check target-specific kmods
          find sdk/bin/targets/mvebu/cortexa9/ -name "*.ipk" -exec cp {} output/ \;

      - name: Upload IPK Artifacts
        uses: actions/upload-artifact@v4
        with:
          name: QModem-OpenWrt-24.10.4-mvebu
          path: output/
